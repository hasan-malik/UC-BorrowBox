# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=change_me_to_a_long_random_string

# Postgres
# Local (docker-compose):
DATABASE_URL=postgres://ucbb:ucbb_dev@localhost:5433/ucbb
# Production (Railway injects this automatically when you attach a Postgres plugin)

# CORS — comma-separated list of allowed client origins.
# Leave empty to allow all (dev only). In production, set to your Netlify URL.
CLIENT_ORIGIN=

# Email via Brevo HTTP API — optional in dev (codes print to console if unset)
# Railway blocks outbound SMTP, so we use Brevo's HTTP API instead.
BREVO_API_KEY=
EMAIL_FROM=

# Restrict signup to utoronto.ca emails. Set to "false" to allow any email.
RESTRICT_UOFT_EMAIL=true
