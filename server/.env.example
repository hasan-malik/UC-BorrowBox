# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=change_me_to_a_long_random_string

# Postgres
# Local (docker-compose):
DATABASE_URL=postgres://ucbb:ucbb_dev@localhost:5433/ucbb
# Production (Railway injects this automatically when you attach a Postgres plugin)

# CORS — comma-separated list of allowed client origins.
# Leave empty to allow all (dev only). In production, set to your Netlify URL.
CLIENT_ORIGIN=

# Email via Brevo HTTPS API. Required in production; without it,
# sendOtpEmail throws and verification codes never reach users. Get an
# API key at https://app.brevo.com/settings/keys/api (starts with xkeysib-).
# Railway blocks outbound SMTP, so HTTPS API is the only viable path.
BREVO_API_KEY=

# Sender email address. Must match a verified sender on your Brevo
# account (verify at https://app.brevo.com/senders). If unverified or
# unset, Brevo replaces the sender with a *.brevosend.com subdomain.
EMAIL_FROM=

# Restrict signup to utoronto.ca emails. Set to "false" to allow any email.
RESTRICT_UOFT_EMAIL=true

# Show seeded demo listings (authored by *.demo@mail.utoronto.ca users).
# Default is off so real users see a clean feed. Flip to "true" to instantly
# restore the seeded demo data — nothing is deleted when this is off.
SHOW_DEMO_LISTINGS=false
